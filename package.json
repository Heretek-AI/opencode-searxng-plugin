{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@heretek-ai/opencode-searxng",
  "version": "0.1.0",
  "description": "SearXNG web search provider + searxng tool for opencode v2 (self-hosted, no API key)",
  "type": "module",
  "license": "MIT",
  "author": "heretek-ai",
  "homepage": "https://github.com/Heretek-AI/opencode-searxng-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/opencode-searxng-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Heretek-AI/opencode-searxng-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "websearch",
    "searxng",
    "search",
    "self-hosted",
    "heretek-ai"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.30",
    "@opencode/schema": "^2.0.30",
    "@types/node": "^22.7.0",
    "effect": "4.0.1",
    "typescript": "^5.6.3"
  }
}
